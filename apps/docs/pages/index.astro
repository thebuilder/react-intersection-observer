---
import data from "blume:data";
import PageLayout from "blume/components/layout/PageLayout.astro";
import Landing from "./_home/Landing.tsx";
import "./_home/home.css";

const { config } = data;
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  banner={config.banner}
  analytics={config.analytics}
  navigation={data.navigation}
  favicon={config.favicon}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={config.search?.enabled}
  siteUrl={config.site}
  ogEnabled={config.og?.enabled}
  ogImage="/og-home.png"
  page={{
    title:
      "React Intersection Observer: tiny, typed viewport detection for React",
    description: config.description,
  }}
>
  <!--
    Arm scroll-reveal before first paint: flag the page so `.rio-reveal`
    elements start hidden (opacity 0) only when JS is present and motion is
    allowed. With no JS or reduced motion the flag is never set and all content
    stays visible. Runs before the island below it is painted.
  -->
  <script is:inline>
    if (
      !window.matchMedia("(prefers-reduced-motion: reduce)").matches
    ) {
      document.documentElement.setAttribute("data-rio-js", "");
    }
  </script>

  <Landing client:load />

  <footer class="rio-footer" slot="footer">
    <div class="rio-footer__inner">
      <div class="rio-footer__brand">
        <strong>React Intersection Observer</strong>
        <span>
          MIT licensed · built by <a
            href="https://github.com/thebuilder"
            rel="noreferrer"
            target="_blank">thebuilder</a
          >
        </span>
      </div>
      <nav class="rio-footer__nav" aria-label="Footer">
        <a href="/overview">Docs</a>
        <a href="/api/core-apis">API</a>
        <a href="/guides/recipes">Recipes</a>
        <a href="/changelog">Changelog</a>
        <a href="https://github.com/thebuilder/react-intersection-observer" rel="noreferrer" target="_blank">GitHub</a>
        <a href="https://www.npmjs.com/package/react-intersection-observer" rel="noreferrer" target="_blank">npm</a>
      </nav>
    </div>
  </footer>
</PageLayout>
